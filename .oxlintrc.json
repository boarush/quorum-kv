{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "ignorePatterns": ["node_modules/**", ".alchemy/**", ".wrangler/**"]
}
