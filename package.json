{
  "name": "quorum-kv",
  "version": "0.1.0",
  "description": "A quorum-replicated binary key-value store for Cloudflare Workers",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:workers": "npm run build",
    "test:workers": "vitest run --project workers",
    "typecheck": "npm run build && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "predev": "npm run build",
    "dev": "alchemy dev",
    "predeploy": "npm run build",
    "deploy": "alchemy deploy"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@cloudflare/vitest-plugin": "1.7.0",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.6.6",
    "alchemy": "2.0.0-beta.85",
    "effect": "^4.1.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261110.0-beta",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "latest",
    "vitest": "5.0.4",
    "ws": "8.22.2"
  },
  "overrides": {
    "workerd": "1.20261112.1"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261112.1": true
  }
}
